# ==============================================================================
# PAYFLOW ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholder secrets
# ==============================================================================

SPRING_PROFILES_ACTIVE=docker
SERVER_IP=192.168.1.6

GATEWAY_PORT=9000
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8888
AUTH_SERVICE_PORT=8082
MERCHANT_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
LEDGER_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888

DB_USERNAME=root
DB_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=secuirty

SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/payflow_notification

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin_payflow_master
S3_SECRET_KEY=StrongMasterSecretKey#2026Secure
MINIO_ROOT_USER=admin_payflow_master
MINIO_ROOT_PASSWORD=StrongMasterSecretKey#2026Secure
S3_AVATAR_BUCKET=user-avatars
S3_KYC_BUCKET=merchant-documents
S3_REGION=us-east-1

JWT_SECRET=super-secret-jwt-signing-key-at-least-64-characters-long-payflow-master-secure
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
ENCRYPTION_SECRET_KEY=payflow-256-bit-aes-gcm-secret-key-32b!

STRIPE_BASE_URL=https://api.stripe.com
RAZORPAY_BASE_URL=https://api.razorpay.com
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_READ_TIMEOUT_MS=5000

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@payflow.com
SPRING_MAIL_PASSWORD=your_email_app_password
